# Admin server used by video relay/reporting and legacy WebRTC registration.
SIRENA_ADMIN_SERVER_URL=http://admin-server.example.com:8080

# Server/WireGuard host and port receiving SRT video.
SIRENA_SRT_HOST=10.0.0.1
SIRENA_SRT_PORT=8890

# Video relay camera polling interval.
SIRENA_VIDEO_RELAY_POLL_INTERVAL=5.0

# Local video manager config path and UI defaults.
SIRENA_VIDEO_MANAGER_HOST=0.0.0.0
SIRENA_VIDEO_MANAGER_PORT=9000
SIRENA_VIDEO_CONFIG_PATH=/opt/sirena-video/sirena_video_config.json
SIRENA_VIDEO_MODE=srt
SIRENA_VIDEO_FPS=30
SIRENA_VIDEO_BITRATE=1000
SIRENA_VIDEO_WIDTH=640
SIRENA_VIDEO_HEIGHT=512

# GStreamer video capture and encode settings.
VIDEO_DEVICE=/dev/video0
STREAM_FPS=30
BITRATE_KBPS=2000
KEYINT=15
# auto = v4l2h264enc (HW, RPi4) якщо доступний, інакше x264enc; v4l2 | x264 — примусово.
VIDEO_ENCODER=auto

# SRT link latency (ms) — буфер відновлення втрат для webrtc-relay SRT URI.
# 20 замало для польових лінків; 150-200 — робочий діапазон.
SRT_LATENCY_MS=200

# Optional video overlay telemetry settings.
OSD_MODE=hud-lite
OSD_RATE_HZ=5
SIRENA_TELEMETRY_SNAPSHOT_PATH=/tmp/sirena_mavlink_snapshot.json
MAVLINK_ENDPOINT=udp:127.0.0.1:14562

# Legacy WebRTC camera mode settings.
PORT=8092
WIDTH=640
HEIGHT=512
FPS=30
INPUT_FORMAT=YUY2
SIRENA_REGISTRY_ENABLED=1
SIRENA_HANDSHAKE_TIMEOUT=300
SIRENA_HANDSHAKE_INTERVAL=10
SIRENA_WEBRTC_VIDEO_VERSION=v1.0.0-webrtc
