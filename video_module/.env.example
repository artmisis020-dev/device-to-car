# Admin server used by video relay/reporting and video service registration.
SIRENA_ADMIN_SERVER_URL=http://admin-server.example.com:8080

# Server/WireGuard host receiving video, і окремі порти на протокол —
# мають збігатись з rtspAddress/srtAddress у mediamtx.yml на сервері.
SIRENA_SRT_HOST=10.0.0.1
SIRENA_RTSP_PORT=8554
SIRENA_SRT_PORT=8890

# Video relay camera polling interval.
SIRENA_VIDEO_RELAY_POLL_INTERVAL=5.0

# Local video manager config path and UI defaults — читаються ОБОМА
# streaming-скриптами (video_streamer_minimal_managed.py, srt_relay_capture.py)
# як fallback, коли sirena_video_config.json ще не існує або не має значення;
# сама панель керування (UI) записує в JSON і має пріоритет над цими env.
SIRENA_VIDEO_MANAGER_HOST=0.0.0.0
SIRENA_VIDEO_MANAGER_PORT=9000
SIRENA_VIDEO_CONFIG_PATH=/opt/sirena-video/sirena_video_config.json
SIRENA_VIDEO_MODE=srt
SIRENA_VIDEO_FPS=30
SIRENA_VIDEO_BITRATE=1000
SIRENA_VIDEO_WIDTH=640
SIRENA_VIDEO_HEIGHT=512

# GStreamer video capture and encode settings (спільні для обох режимів).
VIDEO_DEVICE=/dev/video0
# GOP: video-streamer (RTSP, без ARQ) дефолтить на 15 — швидше відновлення
# після втрати пакета; srt-relay-capture (SRT, з ARQ) дефолтить на fps
# (~30) — довший GOP, краща компресія, бо втрати вже покриті ретрансмісією.
KEYINT=15
# auto = v4l2h264enc (HW, RPi4) якщо доступний, інакше x264enc; v4l2 | x264 — примусово.
VIDEO_ENCODER=auto
# baseline | main | high — main дає кращу компресію (CABAC) за той самий
# бітрейт без доданої затримки (B-frames лишаються вимкненими окремо).
H264_PROFILE=main
# ultrafast | superfast | veryfast | faster | fast | medium ... —
# швидші пресети не додають затримки (без lookahead/B-frames), лише
# гірша якість/бітрейт-ефективність за той самий CPU-бюджет.
X264_SPEED_PRESET=superfast

# SRT link latency (ms) — буфер відновлення втрат для srt-relay-capture SRT URI.
# 20 замало для польових лінків; 150-200 — робочий діапазон.
SRT_LATENCY_MS=200

# SRT relay capture settings (camera → SRT relay, без локального переглядача).
# WIDTH/HEIGHT/FPS/BITRATE тепер спільні з рядком вище (SIRENA_VIDEO_*) —
# тут лишається тільки те, що специфічне саме для цього шляху.
INPUT_FORMAT=YUY2
SIRENA_REGISTRY_ENABLED=1
SIRENA_HANDSHAKE_TIMEOUT=300
SIRENA_HANDSHAKE_INTERVAL=10
SIRENA_VIDEO_RELAY_VERSION=v1.0.0-relay

# Адаптивний бітрейт для srt-relay-capture: підстроює живий x264enc під
# оцінку пропускної здатності SRT-лінка (stats.bandwidth-mbps) і реальні
# втрати пакетів — знижує бітрейт на поганому лінку, плавно повертає на
# цільовий, коли лінк відновлюється. Працює лише для софтового x264enc
# (VIDEO_ENCODER=auto/x264); з апаратним v4l2h264enc — вимикається сама
# (live bitrate control на RPi не перевірявся).
ADAPTIVE_BITRATE=1
ADAPTIVE_BITRATE_INTERVAL_SEC=2
# 0 = авто: max(150, 20% від SIRENA_VIDEO_BITRATE).
ADAPTIVE_BITRATE_MIN_KBPS=0
