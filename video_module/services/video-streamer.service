[Unit]
Description=Sirena Video Streamer (SRT)
After=network.target

[Service]
Type=simple
User=sirena
WorkingDirectory=/opt/sirena-video
ExecStart=/opt/sirena-video/venv/bin/python3 /opt/sirena-video/video_streamer_minimal_managed.py
Restart=on-failure
RestartSec=5s
StandardOutput=journal
StandardError=journal
SyslogIdentifier=video-streamer
Environment=PYTHONUNBUFFERED=1
EnvironmentFile=/opt/sirena/.env
EnvironmentFile=-/etc/default/sirena-relay

[Install]
WantedBy=multi-user.target
