[Unit]
Description=Sirena Video Streamer (RTSP)
After=network-online.target video-relay.service
Wants=network-online.target video-relay.service
StartLimitIntervalSec=60
StartLimitBurst=12

[Service]
Type=simple
User=sirena
WorkingDirectory=/opt/sirena-video
Environment=PYTHONUNBUFFERED=1
EnvironmentFile=/opt/sirena/.env
EnvironmentFile=-/etc/default/sirena-relay
ExecStart=/opt/sirena-video/venv/bin/python3 /opt/sirena-video/video_streamer_minimal_managed.py
Restart=on-failure
RestartSec=5s
StandardOutput=journal
StandardError=journal
SyslogIdentifier=video-streamer

Environment=RECORD_ENABLED=1
Environment=RECORD_SEGMENT_SEC=60
Environment=RECORD_MIN_FREE_MB=50
# Environment=RECORD_DIR=/opt/sirena-video/recordings/local

[Install]
WantedBy=multi-user.target
