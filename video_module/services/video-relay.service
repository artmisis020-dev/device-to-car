[Unit]
Description=Sirena Video Relay (camera target publisher)
After=network-online.target video-service-manager.service
Wants=network-online.target video-service-manager.service

[Service]
Type=simple
User=root
WorkingDirectory=/opt/sirena-video
EnvironmentFile=/opt/sirena/.env
ExecStart=/opt/sirena-video/venv/bin/python3 /opt/sirena-video/video_relay.py
Restart=on-failure
RestartSec=10
StandardOutput=journal
StandardError=journal
SyslogIdentifier=video-relay
Environment=PYTHONUNBUFFERED=1

[Install]
WantedBy=multi-user.target
