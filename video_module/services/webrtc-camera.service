[Unit]
Description=Sirena WebRTC Camera Server
After=network.target
Wants=network.target

[Service]
Type=simple
User=sirena
WorkingDirectory=/opt/sirena-video
Environment=PYTHONPATH=/opt/sirena-video
Environment=PYTHONUNBUFFERED=1
EnvironmentFile=/opt/sirena/.env
ExecStart=/opt/sirena-video/venv/bin/python3 /opt/sirena-video/webrtc_camera.py
Restart=always
RestartSec=5s
StandardOutput=journal
StandardError=journal
SyslogIdentifier=webrtc-camera

[Install]
WantedBy=multi-user.target
