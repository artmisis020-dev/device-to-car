[Unit]
Description=Sirena Additional — CSI (нижня) камера: легкий live-стрім для перевірки (без запису)
Documentation=file:///opt/sirena-additional/lowercam/lowercam_capture.py
After=network-online.target
Wants=network-online.target
# Камеру може тримати лише один процес (див. additional-lowercam.service).
Conflicts=additional-lowercam.service

[Service]
Type=simple
# Той самий root, що й попередній record.sh (rpicam-vid потребує доступу
# до /dev/media*, /dev/dma_heap і т.д.; /home/manager/recordings і далі
# root:root — зміна на іншого користувача тут означала б новий permission-
# баг того самого класу, що вже тричі ловився цієї сесії деінде). Це
# єдиний additional-модуль, що працює від root, а не від sirena — інші
# (напр. pixel_tracking) лише читають кадри, а не займають /dev/media*.
EnvironmentFile=-/opt/sirena/.env
Environment=PYTHONUNBUFFERED=1
ExecStart=/usr/bin/python3 /opt/sirena-additional/lowercam/lowercam_capture.py preview
# Вмикає/вимикає адмінка (вибір нижньої камери у вікні телеметрії).
Restart=on-failure
RestartSec=3s
KillSignal=SIGTERM
# mixed: SIGTERM лише головному процесу (python), а не всім одразу — він сам
# штатно зупиняє rpicam-vid (SIGINT), інакше _pts.txt/_frames.json лишались
# неповними (перевірено на борту). Залишки — SIGKILL після TimeoutStopSec.
KillMode=mixed
TimeoutStopSec=15
StandardOutput=journal
StandardError=journal
SyslogIdentifier=lowercam-preview

[Install]
WantedBy=multi-user.target
