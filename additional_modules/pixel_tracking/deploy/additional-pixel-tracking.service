[Unit]
Description=Sirena Pixel Tracking control-API (RPi; actual tracking runs inside srt-relay-capture via tee)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=sirena
WorkingDirectory=/opt/sirena-additional
EnvironmentFile=/opt/sirena-additional/.env
Environment=PYTHONUNBUFFERED=1
ExecStart=/opt/sirena-additional/.venv/bin/python3 -m pixel_tracking.main
Restart=on-failure
RestartSec=5s
StandardOutput=journal
StandardError=journal
SyslogIdentifier=sirena-pixel-tracking

[Install]
WantedBy=multi-user.target
