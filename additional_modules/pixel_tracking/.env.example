# Control-API bind host/port (адмінка звертається сюди напряму по WireGuard).
SIRENA_TRACK_HOST=0.0.0.0
SIRENA_TRACK_PORT=9075

# Той самий .env, що вже читають/пишуть sirena_manager і video_module —
# жодного нового джерела правди для активної камери/режиму.
SIRENA_ROOT_ENV_PATH=/opt/sirena/.env

# Файли для передачі цілі/статусу в/з video_module (той самий процес, що
# й камера — SIRENA_TRACK_TAP=1 вмикає другу гілку його GStreamer-пайплайна,
# tee, без окремого loopback-пристрою). Дефолти тут мають збігатись з
# video_module/capture_relay/config.py::TRACK_TARGET_FILE/TRACK_STATUS_FILE.
SIRENA_TRACK_TARGET_FILE=/opt/sirena/track_target.json
SIRENA_TRACK_STATUS_FILE=/opt/sirena/track_status.json

SIRENA_SYSTEMCTL=sudo systemctl
