# Admin server used by navigation registration and heartbeat.
SIRENA_ADMIN_SERVER_URL=http://admin-server.example.com:8080

# Version string reported to the admin registry.
SIRENA_VERSION=dev



# Navigation UART device paths.
SIRENA_UART_GPS_PORT=/dev/ttyAMA2
SIRENA_UART_FC_PORT=/dev/ttyAMA3

# Інерційка / злиття Starlink (див. navigation_module/config.py)
# SIRENA_NAV_RAW_IMU_RATE_HZ=50
# SIRENA_NAV_ATTITUDE_RATE_HZ=25
# SIRENA_NAV_PRESSURE_RATE_HZ=10
# SIRENA_NAV_AUX_IMU_RATE_HZ=10
# SIRENA_NAV_MOTOR_RATE_HZ=10
# SIRENA_NAV_VIBRATION_RATE_HZ=2
# SIRENA_NAV_ACCEL_MODEL=hover
# SIRENA_NAV_DRAG_DAMPING=0.5
# SIRENA_NAV_USE_STARLINK_FIXES=1
# SIRENA_INERTIA_RAW_LOG_DIR=/home/sirena/logs
