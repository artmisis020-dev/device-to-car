# Admin server used by navigation registration and heartbeat.
SIRENA_ADMIN_SERVER_URL=http://admin-server.example.com:8080

# Version string reported to the admin registry.
SIRENA_VERSION=dev

# Optional DTC/NMEA UDP destination.
SIRENA_DTC_IP=127.0.0.1

# Starlink dish IP address.
SIRENA_STARLINK_IP=192.168.100.1

# Navigation UART device paths.
SIRENA_UART_GPS_PORT=/dev/ttyAMA2
SIRENA_UART_FC_PORT=/dev/ttyAMA3
