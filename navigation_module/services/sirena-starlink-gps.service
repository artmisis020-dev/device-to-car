[Unit]
Description=Sirena Starlink GPS to MAVLink GPS_INPUT
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=sirena
WorkingDirectory=/opt/sirena-navigation
ExecStart=/opt/sirena-navigation/venv/bin/python /opt/sirena-navigation/starlink_gps_service.py
Restart=on-failure
RestartSec=5s
StandardOutput=journal
StandardError=journal
SyslogIdentifier=sirena-starlink-gps
Environment=PYTHONUNBUFFERED=1
Environment=PYTHONPATH=/opt/sirena-navigation
EnvironmentFile=/opt/sirena/.env
MemoryLimit=256M

[Install]
WantedBy=multi-user.target
