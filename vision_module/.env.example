# Control-API bind host/port (адмінка звертається сюди по WireGuard).
SIRENA_VISION_HOST=0.0.0.0
SIRENA_VISION_PORT=9080

# Підмодуль/можливість за замовчуванням, якщо адмінка не вказала свою.
SIRENA_VISION_DEFAULT_CAPABILITY=object_classifier
SIRENA_VISION_DEFAULT_INTERVAL_S=0.5

# Опційний Bearer-токен на /api/v1/infer/* — захист поверх ізоляції
# WireGuard. Порожньо = довіра мережі (як порт 9070 sirena_manager сьогодні).
SIRENA_VISION_CONTROL_TOKEN=

# "cuda" або "cpu".
SIRENA_VISION_TORCH_DEVICE=cuda
