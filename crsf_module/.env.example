# UART до польотного контролера для CRSF RC uplink.
# УВАГА: не має збігатися з MAVLink router UART (/dev/ttyAMA0 @115200).
SIRENA_CRSF_UART_PORT=/dev/ttyAMA0
SIRENA_CRSF_UART_BAUD=420000

# UDP вхід каналів керування (з наземної станції / джойстика).
SIRENA_CRSF_BIND_HOST=0.0.0.0
SIRENA_CRSF_BIND_PORT=5005

# Стартовий режим керування: 'mavlink' (стандарт) або 'crsf'.
# На льоту перемикається командою "MODE CRSF" / "MODE MAVLINK" по UDP.
SIRENA_CONTROL_MODE=mavlink

# Частота відправки CRSF кадрів на FC, Гц.
SIRENA_CRSF_SEND_RATE_HZ=150

# Failsafe: таймаут втрати UDP-зв'язку (сек) і канал газу (індекс 0..15).
SIRENA_CRSF_FAILSAFE_TIMEOUT_SEC=0.5
SIRENA_CRSF_THROTTLE_CHANNEL=2
