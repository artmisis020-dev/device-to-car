# Додати в /opt/sirena/.env на RPi. Усе необов'язкове — дефолти однакові
# для всіх бортів (одна спільна mesh-мережа).

SIRENA_MESH_ID=drone-mesh
SIRENA_MESH_FREQ=5180
SIRENA_MESH_CHWIDTH=HT20
SIRENA_MESH_PREFIX=10.66
SIRENA_MESH_PEER_WAIT_SEC=8

# Лише якщо автовибір не підходить:
# SIRENA_MESH_IFACE=wlan1
# SIRENA_MESH_IP=10.66.0.10

# ─── Uplink watchdog (Starlink failover через mesh) ───
# Інтерфейс Starlink — за замовчуванням той, що веде до WG endpoint.
# SIRENA_UPLINK_IFACE=eth0
# Адреса WG-сервера — за замовчуванням з `wg show wg0 endpoints`.
# SIRENA_UPLINK_TARGET=1.2.3.4
SIRENA_UPLINK_CHECK_HOSTS=1.1.1.1,8.8.8.8
SIRENA_UPLINK_FAIL_THRESHOLD=3
SIRENA_UPLINK_RECOVER_THRESHOLD=5
SIRENA_UPLINK_BEACON_PORT=5077
SIRENA_UPLINK_DIAG_PORT=9076
