[Unit]
Description=Sirena Root Manager
After=network.target

[Service]
Type=simple
User=sirena
WorkingDirectory=/opt/sirena
EnvironmentFile=/opt/sirena/.env
Environment=PYTHONUNBUFFERED=1
Environment=SIRENA_MANAGER_HOST=127.0.0.1
Environment=SIRENA_MANAGER_PORT=9070
ExecStart=/opt/sirena/.venv/bin/python3 /opt/sirena/main.py
Restart=on-failure
RestartSec=5s
StandardOutput=journal
StandardError=journal
SyslogIdentifier=sirena-manager

[Install]
WantedBy=multi-user.target