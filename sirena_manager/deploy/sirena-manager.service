[Unit]
Description=Sirena Root Manager
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=sirena
WorkingDirectory=/opt/sirena
EnvironmentFile=/opt/sirena/.env
Environment=PYTHONUNBUFFERED=1
ExecStart=/opt/sirena/.venv/bin/python3 /opt/sirena/main.py
Restart=on-failure
RestartSec=5s
StandardOutput=journal
StandardError=journal
SyslogIdentifier=sirena-manager

[Install]
WantedBy=multi-user.target
