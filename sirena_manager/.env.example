# Admin server URL used by the RPI root manager for registration.
SIRENA_ADMIN_SERVER_URL=http://admin-server.example.com:8080

# Root manager bind host and port.
SIRENA_MANAGER_HOST=127.0.0.1
SIRENA_MANAGER_PORT=9070

# systemctl command used by supervisor service control endpoints.
SIRENA_SYSTEMCTL=sudo systemctl

# Version string reported to the admin registry.
SIRENA_VERSION=dev

# Optional WireGuard IP override reported to the admin registry.
SIRENA_WG_IP=10.0.0.7
