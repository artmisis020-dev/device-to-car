# Admin server used by telemetry sender.
SIRENA_ADMIN_SERVER_URL=http://admin-server.example.com:8080

# UART device connected to flight-controller MAVLink telemetry.
SIRENA_MAVLINK_UART_PORT=/dev/ttyAMA5

# UART device paths used by navigation bridge defaults.
SIRENA_UART_GPS_PORT=/dev/ttyAMA2
SIRENA_UART_FC_PORT=/dev/ttyAMA3
