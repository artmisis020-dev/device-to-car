# Admin server used by the legacy direct HTTP telemetry sender.
SIRENA_ADMIN_SERVER_URL=http://admin-server.example.com:8080

# Local MAVLink telemetry publisher input and Unix broker socket.
SIRENA_MAVLINK_TELEMETRY_URL=udpin:0.0.0.0:14562
SIRENA_LOCAL_TELEMETRY_SOCKET=/tmp/sirena-mavlink.sock
SIRENA_TELEMETRY_SNAPSHOT_PATH=/tmp/sirena_mavlink_snapshot.json
