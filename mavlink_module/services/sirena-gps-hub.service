[Unit]
Description=Sirena GPS Hub (Starlink + Beitian → FC NMEA + MAVLink proxy)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=sirena
WorkingDirectory=/home/sirena/sirena

ExecStart=/usr/bin/python3 /home/sirena/sirena/main.py

Restart=on-failure
RestartSec=5s

StandardOutput=journal
StandardError=journal
SyslogIdentifier=sirena-gps-hub

Environment=PYTHONUNBUFFERED=1
Environment=PYTHONDONTWRITEBYTECODE=1
Environment=PYTHONPATH=/home/sirena/sirena:/home/sirena/sirena/starlink-grpc-tools

MemoryLimit=256M

[Install]
WantedBy=multi-user.target
