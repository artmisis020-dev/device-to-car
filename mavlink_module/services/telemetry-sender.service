[Unit]
Description=Sirena Telemetry Sender (MAVLink → HTTP server)
After=network-online.target sirena-gps-hub.service
Wants=network-online.target

[Service]
Type=simple
User=sirena
WorkingDirectory=/home/sirena/sirena
ExecStart=/usr/bin/python3 /home/sirena/sirena/telemetry_daemon.py
Restart=on-failure
RestartSec=10s
StandardOutput=journal
StandardError=journal
SyslogIdentifier=telemetry-sender
Environment=PYTHONUNBUFFERED=1

[Install]
WantedBy=multi-user.target
