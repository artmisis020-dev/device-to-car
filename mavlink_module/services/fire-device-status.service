[Unit]
Description=Sirena Device Status Parser (UART -> MAVLink)
After=network-online.target mavlink-router.service
Wants=network-online.target mavlink-router.service

[Service]
Type=simple
User=sirena
WorkingDirectory=/opt/sirena-telemetry
EnvironmentFile=/opt/sirena/.env
ExecStart=/opt/sirena-telemetry/venv/bin/python3 /opt/sirena-telemetry/fire_device_status_daemon.py
Restart=on-failure
RestartSec=5s
StandardOutput=journal
StandardError=journal
SyslogIdentifier=fire-device-status
Environment=PYTHONUNBUFFERED=1

[Install]
WantedBy=multi-user.target
