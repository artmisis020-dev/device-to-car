[Unit]
Description=Sirena MAVLink Router
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=sirena
WorkingDirectory=/opt/sirena-telemetry
ExecStartPre=+/bin/chgrp dialout /dev/ttyAMA0
ExecStartPre=+/bin/chmod 0660 /dev/ttyAMA0
ExecStart=/opt/sirena-telemetry/run_mavlink_router.sh
Restart=on-failure
RestartSec=5s
StandardOutput=journal
StandardError=journal
SyslogIdentifier=mavlink-router
Environment=PYTHONUNBUFFERED=1
EnvironmentFile=/opt/sirena/.env
Environment=MAVLINK_ROUTER_CONFIG=/opt/sirena-telemetry/mav-router.conf
Environment=MAVLINK_ROUTER_FALLBACK=/opt/sirena-telemetry/mavlink_router.py
Environment=MAVLINK_ROUTER_PYTHON=/opt/sirena-telemetry/venv/bin/python3

[Install]
WantedBy=multi-user.target
