[Unit]
Description=Sirena MAVLink Python Router (Fallback)
After=network.target

[Service]
Type=simple
User=sirena
WorkingDirectory=/opt/sirena-telemetry
ExecStart=/opt/sirena-telemetry/venv/bin/python3 /opt/sirena-telemetry/mavlink_router.py
Restart=on-failure
RestartSec=10s
StandardOutput=journal
StandardError=journal
SyslogIdentifier=mavlink-router
Environment=PYTHONUNBUFFERED=1

[Install]
WantedBy=multi-user.target