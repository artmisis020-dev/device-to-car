+// ackBase is where ACK/NAK scanning starts. Sirena patch: packets are now
+// delivered as soon as they are ripe and contiguous with the last delivered
+// one, without waiting for the next periodic ACK (10ms) to advance
+// lastACKSequenceNumber — so the last delivered sequence number can be ahead
+// of the last ACK. Scanning from the older ACK would treat the delivered (and
+// already removed) packets as a gap: ACK would stall and NAK would request
+// them again.
+func (r *receiver) ackBase() circular.Number {
+	if r.lastDeliveredSequenceNumber.Gt(r.lastACKSequenceNumber) {
+		return r.lastDeliveredSequenceNumber
+	}
+	return r.lastACKSequenceNumber
+}
