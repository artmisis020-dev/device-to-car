diff --git a/congestion/live/receive_sirena_test.go b/congestion/live/receive_sirena_test.go
new file mode 100644
index 0000000..c0e4e3a
--- /dev/null
+++ b/congestion/live/receive_sirena_test.go
@@ -0,0 +1,61 @@
+package live
+
+import (
+	"net"
+	"testing"
+
+	"github.com/datarhei/gosrt/circular"
+	"github.com/datarhei/gosrt/packet"
+	"github.com/stretchr/testify/require"
+)
+
+// Sirena patch: a ripe packet contiguous with the last delivered one is
+// delivered on the next Tick without waiting for the periodic ACK, and the
+// following ACK/NAK must not treat those delivered packets as missing.
+func TestRecvDeliverBeforeACK(t *testing.T) {
+	acks := []uint32{}
+	naks := [][2]uint32{}
+	numbers := []uint32{}
+	recv := mockLiveRecv(
+		func(seq circular.Number, light bool) { acks = append(acks, seq.Val()) },
+		func(from, to circular.Number) { naks = append(naks, [2]uint32{from.Val(), to.Val()}) },
+		func(p packet.Packet) { numbers = append(numbers, p.Header().PacketSequenceNumber.Val()) },
+	)
+	addr, _ := net.ResolveIPAddr("ip", "127.0.0.1")
+	push := func(seq uint32, tsbpd uint64) {
+		p := packet.NewPacket(addr)
+		p.Header().PacketSequenceNumber = circular.New(seq, packet.MAX_SEQUENCENUMBER)
+		p.Header().PktTsbpdTime = tsbpd
+		recv.Push(p)
+	}
+
+	for i := uint32(0); i < 5; i++ {
+		push(i, 1)
+	}
+	recv.Tick(1) // before the first ACK period
+	require.Empty(t, acks)
+	require.Exactly(t, []uint32{0, 1, 2, 3, 4}, numbers)
+
+	// gap at 5 (6..7 not ripe yet): nothing is delivered past the gap
+	push(6, 40)
+	push(7, 40)
+	recv.Tick(2)
+	require.Exactly(t, []uint32{0, 1, 2, 3, 4}, numbers)
+
+	// periodic ACK: starts after the delivered packets, not at 0
+	recv.Tick(10)
+	require.NotEmpty(t, acks)
+	require.Equal(t, uint32(5), acks[0]) // next expected = the gap, not 0
+
+	// periodic NAK reports only the real gap (5), never delivered packets
+	recv.Tick(25)
+	require.NotEmpty(t, naks)
+	for _, n := range naks {
+		require.Equal(t, [2]uint32{5, 5}, n)
+	}
+
+	// once the gap is filled the rest is delivered in order
+	push(5, 40)
+	recv.Tick(40)
+	require.Exactly(t, []uint32{0, 1, 2, 3, 4, 5, 6, 7}, numbers)
+}
