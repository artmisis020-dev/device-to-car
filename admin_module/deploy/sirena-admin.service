[Unit]
Description=Sirena Device Registry
After=network.target

[Service]
User=sirena
WorkingDirectory=/opt/sirena-admin
EnvironmentFile=/opt/sirena-admin/.env
ExecStart=/opt/sirena-admin/.venv/bin/gunicorn \
    --workers 1 \
    --worker-class gthread \
    --threads 8 \
    --bind 0.0.0.0:8080 \
    --worker-tmp-dir /tmp \
    "admin_module.main:app"
Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target