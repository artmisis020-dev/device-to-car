# Database path (SQLite file)
SIRENA_DB=/opt/sirena-server/devices.db

# Directory where video recordings are stored
SIRENA_RECORDINGS=/opt/sirena-video/recordings

# Flask session secret — generate with:
#   python -c "import secrets; print(secrets.token_hex(32))"
SIRENA_SECRET_KEY=

# Admin panel password
ADMIN_PASSWORD=
