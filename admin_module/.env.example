# Required Flask session secret. Generate a real value with:
# python -c "import secrets; print(secrets.token_hex(32))"
SIRENA_SECRET_KEY=change-me-generate-a-random-secret

# Required key for reversibly encrypting user passwords (so admins can view
# them on demand). Generate a real value with:
# python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# Losing/rotating this key makes existing encrypted passwords undecryptable —
# back it up like SIRENA_SECRET_KEY.
SIRENA_PASSWORD_ENC_KEY=change-me-generate-a-fernet-key

# SQLite database path for registered devices, telemetry, and admin state.
SIRENA_DB=/opt/sirena-server/devices.db

# Directory where server-side video recordings are stored.
SIRENA_RECORDINGS=/opt/sirena-video/recordings

# MediaMTX HLS HTTP port used by the admin UI.
MEDIAMTX_HLS_PORT=8888

# Public MediaMTX WebRTC base URL reachable by browser clients.
MEDIAMTX_WEBRTC_PUBLIC_URL=http://public-server.example.com:8889

# Optional comma-separated public IPs/domains added to MediaMTX WebRTC ICE answers.
MEDIAMTX_ADDITIONAL_HOSTS=public-server.example.com

# Optional legacy WebRTC proxy upstream reachable from the admin server.
WEBRTC_PROXY_UPSTREAM=http://127.0.0.1:8092

# Timeout in seconds for legacy WebRTC proxy requests.
WEBRTC_PROXY_TIMEOUT_S=20

# Admin Flask bind host and port.
SIRENA_HOST=0.0.0.0
SIRENA_PORT=8080

# Enable only for local development, never for production.
SIRENA_DEBUG=false

# Set true when admin is served over HTTPS.
SIRENA_COOKIE_SECURE=false

# Admin session lifetime in minutes.
SIRENA_SESSION_LIFETIME_MIN=720

# Login throttling: maximum attempts in the time window below.
SIRENA_LOGIN_MAX_ATTEMPTS=10

# Login throttling window in seconds.
SIRENA_LOGIN_WINDOW_S=600

# Maximum telemetry rows accepted per request.
SIRENA_TELEMETRY_MAX_BATCH=2000

# Maximum HTTP request body size in bytes.
SIRENA_MAX_CONTENT_LENGTH=2097152
