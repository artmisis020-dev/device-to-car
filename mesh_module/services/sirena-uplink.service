[Unit]
Description=Sirena Uplink Watchdog (Starlink failover через mesh сусіда)
# Живе рівно стільки, скільки піднятий mesh: стоп mesh → стоп сторожа.
BindsTo=sirena-mesh.service
After=sirena-mesh.service
StartLimitIntervalSec=0

[Service]
Type=simple
EnvironmentFile=-/opt/sirena/.env
ExecStart=/usr/bin/python3 /opt/sirena-mesh/uplink_watchdog.py
Restart=on-failure
RestartSec=2s
TimeoutStopSec=10s
StandardOutput=journal
StandardError=journal
SyslogIdentifier=sirena-uplink
Environment=PYTHONUNBUFFERED=1

[Install]
# enable → sirena-mesh.service.wants/: старт mesh (при завантаженні чи
# кнопкою) тягне за собою сторожа.
WantedBy=sirena-mesh.service
