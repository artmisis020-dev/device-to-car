[Unit]
Description=Sirena Mesh (802.11s на окремому USB Wi-Fi адаптері)
# Не enabled: запускає/зупиняє sirena-mesh-agent (mesh_agent.py) — за конфігом
# групи з адмінки (кешується на борті, тож і без зв'язку з адмінкою) і
# наявністю USB Wi-Fi адаптера.
After=network.target NetworkManager.service
# Адаптера може ще не бути (USB) — повторюємо без ліміту.
StartLimitIntervalSec=0

[Service]
Type=oneshot
RemainAfterExit=yes
EnvironmentFile=-/opt/sirena/.env
# Конфіг групи від агента (SIRENA_MESH_ID/FREQ/KEY_FILE) — перекриває .env.
EnvironmentFile=-/etc/sirena-mesh/mesh.env
ExecStart=/opt/sirena-mesh/mesh-up.sh
ExecStop=/opt/sirena-mesh/mesh-down.sh
Restart=on-failure
RestartSec=10s
# Менше за таймаут `systemctl start` у sirena_manager (20с).
TimeoutStartSec=18s
StandardOutput=journal
StandardError=journal
SyslogIdentifier=sirena-mesh
