# Додати в /opt/sirena/.env на RPi. Усе необов'язкове — дефолти однакові
# для всіх бортів (одна спільна mesh-мережа).

# 0 — mesh лише кнопкою з адмінки (за замовчуванням піднімається при старті).
SIRENA_MESH_AUTOSTART=1
SIRENA_MESH_ID=drone-mesh
SIRENA_MESH_FREQ=5180
SIRENA_MESH_CHWIDTH=HT20
SIRENA_MESH_PREFIX=10.66
# Лише якщо регіон на образі не виставлено (iw reg get → country 00):
# SIRENA_MESH_COUNTRY=UA

# Лише якщо автовибір не підходить:
# SIRENA_MESH_IFACE=wlan1
# SIRENA_MESH_IP=10.66.0.10

# ─── Uplink watchdog (Starlink failover через mesh) ───
# Інтерфейс Starlink — за замовчуванням той, що має default у таблиці main.
# SIRENA_UPLINK_IFACE=eth0
# Адреса WG-сервера — за замовчуванням з `wg show wg0 endpoints`.
# SIRENA_UPLINK_TARGET=1.2.3.4
SIRENA_UPLINK_CHECK_HOSTS=1.1.1.1,8.8.8.8
# Без жодної ICMP-відповіді через Starlink стільки секунд — перемикання на сусіда.
SIRENA_UPLINK_DEAD_AFTER_SEC=1.0
# Стільки секунд стабільних відповідей — назад на свій Starlink.
SIRENA_UPLINK_RECOVER_AFTER_SEC=3.0
SIRENA_UPLINK_BEACON_PORT=5077
SIRENA_UPLINK_DIAG_PORT=9076
# Сусід не чує нашого unicast стільки секунд — видалити зависший шлях HWMP.
# SIRENA_MESH_MPATH_STUCK_SEC=2.0

# ─── Шифрування (SAE) ───
# Ключ НЕ тут (.env — 0644), а в /etc/sirena-mesh/mesh.key (0600, root), один на
# всі борти групи. Ставиться: sudo SIRENA_MESH_KEY='<ключ>' bash install.sh
# Нема ключа — mesh відкритий. Відкритий і SAE-борт один одного не бачать.
# SIRENA_MESH_KEY_FILE=/etc/sirena-mesh/mesh.key
# Скільки чекати, поки wpa_supplicant підніме mesh (скан частоти + SAE).
# SIRENA_MESH_SAE_WAIT_SEC=8
